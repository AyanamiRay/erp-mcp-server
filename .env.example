# MCP Server 服务端口与主机
PORT=3000
HOST=0.0.0.0

# 客户端与管理端统一安全鉴权 API Key（生产环境请替换为强密码）
MCP_API_KEY=mcp-secret-key-prod-2026

# 持久化存储目录
DATA_DIR=./data

# Redis 连接（可选。单机部署可留空；多副本集群部署请填写以实现跨节点变更广播）
# REDIS_URL=redis://:yourpassword@127.0.0.1:6379/0
# REDIS_CHANNEL=mcp:tool_events

# 调用下游 ERP 接口的默认超时时间 (ms)
DEFAULT_TIMEOUT_MS=5000

# 服务名称与版本声明
MCP_SERVER_NAME=enterprise-erp-mcp
MCP_SERVER_VERSION=1.0.0
